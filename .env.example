# Database (Foundation compose — dev PostgreSQL on localhost:5434, db hominem)
# Start infra from the Foundation repo, not here:
#   docker compose -f compose/base.yml -f compose/dev.yml up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/hominem

# Hominem API (hosted login + session). Under portless each app gets a stable
# https://<name>.lvh.me URL; the proxy runs at
# `pnpm exec portless proxy start --port 443 --tld lvh.me`.
HOMINEM_API_URL=https://api.lvh.me
HOMINEM_INTERNAL_API_URL=https://api.lvh.me

# Newsboy server environment (packages/newsboy/src/lib/infrastructure/env.ts)
NEWSBOY_APP_URL=https://newsboy.lvh.me
# Injected per-worktree by portless at runtime (optional locally)
# PORTLESS_URL=https://<branch>.newsboy.lvh.me

# Admin console allowlist (required in production/Railway)
GAME_ADMIN_EMAILS=you@ponti.io

# OpenRouter (required by LabsServerEnv for every game:* script)
OPENROUTER_API_KEY=sk-or-your-key-here
# OpenRouter text model used for puzzle generation
NEWSBOY_AI_MODEL=openai/gpt-5-mini
